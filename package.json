{
  "name": "lumos-ai-writer",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "overrides": {
      "vite": "7.3.2",
      "@vitejs/plugin-react": "5.1.0"
    }
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @lumos-ai/api --filter web dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "PORT=8788 pnpm --filter @lumos-ai/api dev",
    "dev:extension": "pnpm --filter extension dev",
    "build:pages": "pnpm --filter web build",
    "typecheck:pages": "pnpm --filter @lumos-ai/api exec tsc --noEmit -p ../../tsconfig.cloudflare.json",
    "check:deploy": "pnpm typecheck && pnpm typecheck:pages && pnpm lint && pnpm build:pages",
    "check:extension-artifact": "node scripts/check-extension-artifact.mjs",
    "test:cors": "pnpm --filter @lumos-ai/api test:cors",
    "test:annotation-sync": "pnpm --filter @lumos-ai/api test:annotation-sync",
    "test:cloud-library-identity": "pnpm --filter @lumos-ai/api exec tsx ../../scripts/test-cloud-library-identity.ts",
    "test:cloud-library-operations": "pnpm --filter @lumos-ai/api exec tsx ../../scripts/test-cloud-library-operations.ts",
    "test:cloud-session-refresh": "pnpm --filter @lumos-ai/api exec tsx ../../scripts/test-cloud-session-refresh.ts",
    "test:cloud-trash-reconcile": "pnpm --filter @lumos-ai/api exec tsx ../../scripts/test-cloud-trash-reconcile.ts",
    "test:workspace-recovery": "pnpm --filter @lumos-ai/api exec tsx ../../scripts/test-empty-conversation-recovery.ts",
    "test:workspace-navigation": "pnpm --filter @lumos-ai/api exec tsx ../../scripts/test-workspace-navigation.ts",
    "test:workspace-project-state": "pnpm --filter @lumos-ai/api exec tsx ../../scripts/test-workspace-project-state.ts",
    "test:workspace-draft-state": "pnpm --filter @lumos-ai/api exec tsx ../../scripts/test-workspace-draft-state.ts",
    "test:workspace-review-state": "pnpm --filter @lumos-ai/api exec tsx ../../scripts/test-workspace-review-state.ts",
    "test:workspace-reader-preview-state": "pnpm --filter @lumos-ai/api exec tsx ../../scripts/test-workspace-reader-preview-state.ts",
    "test:workspace-conversation-input-state": "pnpm --filter @lumos-ai/api exec tsx ../../scripts/test-workspace-conversation-input-state.ts",
    "test:workspace-analysis-state": "pnpm --filter @lumos-ai/api exec tsx ../../scripts/test-workspace-analysis-state.ts",
    "test:draft-preference-snapshots": "pnpm --filter @lumos-ai/api exec tsx ../../scripts/test-draft-preference-snapshots.ts",
    "test:draft-quality-snapshots": "pnpm --filter @lumos-ai/api exec tsx ../../scripts/test-draft-quality-snapshots.ts",
    "test:draft-version-history": "pnpm --filter @lumos-ai/api exec tsx ../../scripts/test-draft-version-history.ts",
    "test:learning-result": "pnpm --filter @lumos-ai/api exec tsx ../../scripts/test-learning-result.ts",
    "check:p0": "node scripts/check-p0.mjs",
    "eval:skills": "pnpm --filter @lumos-ai/api eval:skills",
    "smoke:p0": "node scripts/smoke-p0.mjs",
    "smoke:p0:ai": "node scripts/smoke-p0.mjs --ai",
    "smoke:ai-pilot": "node scripts/smoke-ai-pilot.mjs",
    "report:ai": "node scripts/report-ai-usage.mjs",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@rolldown/binding-darwin-arm64": "1.0.0-rc.17",
    "@rollup/rollup-darwin-arm64": "4.60.2"
  }
}
