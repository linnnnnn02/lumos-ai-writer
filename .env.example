# Local MVP integration config.
# Copy this to .env when you are ready to connect real services.

APP_ENV=local
PUBLIC_APP_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_PROXY_TARGET=http://localhost:8788
WXT_PUBLIC_API_BASE_URL=http://localhost:8788/api

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
AUTH_OAUTH_PROVIDERS=github,google

# DeepSeek
AI_PROVIDER_PRIMARY=deepseek
AI_FEATURE_ENABLED=false
DEEPSEEK_API_KEY=
AI_DAILY_BUDGET_CNY=20
AI_DEEPSEEK_INPUT_CNY_PER_1M_TOKENS=
AI_DEEPSEEK_OUTPUT_CNY_PER_1M_TOKENS=
